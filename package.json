{
  "name": "finvayo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:web && npm run build:worker",
    "build:web": "vite build",
    "build:worker": "wrangler deploy --dry-run --outdir dist/worker",
    "cf-typegen": "wrangler types",
    "check": "npm run typecheck && npm run build:web && npm test && npm run build:worker",
    "deploy": "npm run build:web && wrangler deploy",
    "dev": "npm run build:web && wrangler dev",
    "start": "npm run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.5.2",
    "vite": "^7.3.6",
    "vitest": "~4.1.0",
    "wrangler": "^4.129.1"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
