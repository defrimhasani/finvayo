{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "finvayo",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-07",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/health", "/api/*"]
  },
  "limits": {
    "cpu_ms": 50
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "upload_source_maps": true
}
